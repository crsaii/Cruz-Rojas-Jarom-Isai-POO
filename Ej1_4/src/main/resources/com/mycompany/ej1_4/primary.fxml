<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox blendMode="MULTIPLY" cache="true" cacheHint="QUALITY" fillWidth="false" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ej1_4.PrimaryController">
   <children>
      <Label text="Tabla del:" />
      <TextField fx:id="numero"/>
      <Button fx:id="calcular" onAction="#calcular" text="Calcular" />
      <Button fx:id="limpiar" onAction="#limpiar" alignment="BOTTOM_LEFT" mnemonicParsing="false" text="Limpiar" />
      <TextArea fx:id="resultado" prefHeight="200.0" prefWidth="200.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <cursor>
   </cursor>
</VBox>
