<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_LEFT"  spacing="20.0" prefWidth="200" prefHeight="210"  xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ej1_2.PrimaryController">
   <children>
      <Label text="Dinero" />
      <TextField   promptText="Introduce el dinero"  fx:id="txDinero" />
      <Button fx:id="desglosar" text="Desglosar" onAction="#desglosar"/>
      <Button fx:id="x" text="x" onAction="#x"/>
      <Label text="Cantidad y Denomimacion" />
      <TextArea fx:id="txResul" />
   </children>
   <padding>
      <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
