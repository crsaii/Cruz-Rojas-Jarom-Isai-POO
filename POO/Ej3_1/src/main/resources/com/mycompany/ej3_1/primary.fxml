<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ej3_1.PrimaryController">
   <children>
      <Label text="Contar numero de clics" />
      <TextField fx:id="num" />
      <Button fx:id="contar" text="¡Contar!" onAction="#contar"/>
      
      <Label text="Esperara 10 segundos" />
      <Button fx:id="esperar" text="Esperar!" onAction="#esperar" prefWidth="150" />
      
      <ProgressBar fx:id="bar" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
