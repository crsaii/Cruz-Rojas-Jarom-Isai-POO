<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ej1_3.PrimaryController">

    <top>
        <VBox spacing="20.0">
            <padding>
                <Insets top="15.0" right="20.0"
                        bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Cifras y Divisores de un Número"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label text="Ingrese un número"/>
                <TextField fx:id="num" promptText="6915"
                           prefWidth="220.0"/>
                <Button fx:id="analizar" onAction="#analizar"
                        text="Analizar" prefWidth="120.0"/>
                <Button fx:id="limpiar" onAction="#limpiar"
                        text="Limpiar" prefWidth="120.0"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane hgap="25.0" vgap="12.0">
            <padding>
                <Insets top="20.0" right="25.0"
                        bottom="25.0" left="25.0"/>
            </padding>

            <Label text="Cantidad de cifras"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="cantCifra" editable="false"
                       prefWidth="170.0"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Suma de cifras impares"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="impCifra" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Suma de cifras pares"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="parCifra" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Suma total de cifras"
                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="totCifra" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Cifra mayor"
                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="mayCifra" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Cifra menor"
                   GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="menCifra" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Divisores"
                   style="-fx-font-size: 16px; -fx-font-weight: normal;"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <TextArea fx:id="divisores"
                      editable="false"
                      prefWidth="250.0"
                     prefHeight="310.0" wrapText="false" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.rowSpan="5"/>
        </GridPane>
    </center>

</BorderPane>