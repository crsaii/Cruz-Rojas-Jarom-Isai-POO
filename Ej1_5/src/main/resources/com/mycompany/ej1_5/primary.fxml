<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.ej1_5.PrimaryController">

    <top>
        <VBox spacing="20.0">
            <padding>
                <Insets top="15.0" right="20.0"
                        bottom="15.0" left="20.0"/>
            </padding>

            <Label text="Control de Gastos Semanales"
                   style="-fx-font-size: 20px; -fx-font-weight: normal;"/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button fx:id="estadisticas"
                        onAction="#estadisticas"
                        text="Calcular estadísticas"
                        prefWidth="180.0"/>

                <Button fx:id="limpiar"
                        onAction="#limpiar"
                        text="Limpiar"
                        prefWidth="120.0"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane hgap="25.0" vgap="12.0">
            <padding>
                <Insets top="20.0" right="25.0"
                        bottom="25.0" left="25.0"/>
            </padding>

            <Label text="Gastos"
                   style="-fx-font-size: 16px; -fx-font-weight: normal;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>

            <Label text="Importe"
                   style="-fx-font-size: 16px; -fx-font-weight: normal;"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Alimentación"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="alim" promptText="0.00"
                       prefWidth="200.0"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Refrigerios"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="refrig" promptText="0.00"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Transporte"
                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="transp" promptText="0.00"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Telefonía"
                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="tel" promptText="0.00"
                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Otros"
                   GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="otro" promptText="0.00"
                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Estadísticas"
                   style="-fx-font-size: 16px; -fx-font-weight: normal;"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <Label text="Total semanal"
                   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="totSem" editable="false"
                       prefWidth="220.0"
                       GridPane.columnIndex="2" GridPane.rowIndex="2"/>

            <Label text="Gasto más alto"
                   GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <TextField fx:id="altTot" editable="false"
                       prefWidth="220.0"
                       GridPane.columnIndex="2" GridPane.rowIndex="4"/>

        </GridPane>
    </center>

</BorderPane>